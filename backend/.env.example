# Capstone Market Platform - Backend Environment Configuration
# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:1234@localhost:5432/capstone_db

# Allowed CORS Origins (comma-separated list for production domains)
ALLOWED_ORIGINS=https://capstone-market.vercel.app,http://localhost:5173,http://localhost:3000

# JWT Configuration
SECRET_KEY=capstone_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
